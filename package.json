{
  "name": "universal-trust-layer",
  "version": "1.0.0",
  "private": true,
  "author": "Joshua Joel A Okoth <securerise@outlook.com>",
  "license": "CC-BY-NC-ND-4.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "packages/backend",
    "packages/frontend_flutter"
  ],
  "scripts": {
    "setup": "npm install && cd packages/backend && npm install && cd ../../packages/frontend_flutter && flutter pub get",
    "dev": "npm run dev -w packages/backend",
    "build": "npm run build -w packages/backend",
    "test": "npm run test -w packages/backend",
    "lint": "npm run lint -w packages/backend",
    "typecheck:mobile": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-keychain": "9.3.3"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-native": "0.73.0",
    "typescript": "5.6.3"
  }
}

