{
  "expo": {
    "name": "UniversalTrustMobile",
    "slug": "universaltrustmobile",
    "platforms": ["ios", "android"],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "universaltrustmobile",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Authenticate with Face ID to access protected auditor operations and immutable settlement alignment."
      }
    },
    "android": {
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "networkSecurityConfig": "@xml/network_security_config",
      "usesCleartextTraffic": false
    }
  }
}

