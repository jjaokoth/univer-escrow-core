# Environment template for local verification
## Runtime
NODE_ENV=development
PORT=8080

## Settlement / routing
SETTLEMENT_ACCOUNT=880200283180
MASTER_SETTLEMENT_ACCOUNT=880200283180
LEDGER_AUDIT_INTERVAL_MS=5000

## Admin / recovery
ADMIN_RECOVERY_OFFICER_PUBLIC_KEYS=pubkey1,pubkey2
ADMIN_RECOVERY_THRESHOLD_M=2

## Notary / services
NOTARY_ENDPOINT_BASE_URL=http://localhost:8099

## Mpesa (example/sandbox values)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=600000
MPESA_CALLBACK_URL=https://example.com/mpesa/callback
MPESA_STATUS_CALLBACK_URL=https://example.com/mpesa/status
MPESA_B2C_SHORTCODE=600000
MPESA_B2C_INITIATOR_NAME=initiator_name
MPESA_B2C_SECURITY_CREDENTIAL=base64-credential
MPESA_B2C_RESULT_URL=https://example.com/mpesa/b2c/result
MPESA_B2C_QUEUE_TIMEOUT_URL=https://example.com/mpesa/b2c/queue
MPESA_B2C_REMARKS="Refund for {transactionId}"
MPESA_B2C_COMMAND_ID=BusinessPayment

MPESA_REVERSAL_INITIATOR_NAME=rev_initiator
MPESA_REVERSAL_SECURITY_CREDENTIAL=rev-base64-credential
MPESA_REVERSAL_RESULT_URL=https://example.com/mpesa/reversal/result
MPESA_REVERSAL_QUEUE_TIMEOUT_URL=https://example.com/mpesa/reversal/queue
MPESA_REVERSAL_RECEIVER_PARTY=receiver
MPESA_REVERSAL_REMARKS="Escrow refund reversal"
MPESA_REVERSAL_OCCASION=REFUND

## Security / logging
ENV_MASTER_KEY=replace_with_random_master_key
ENCLAVE_LOG_SHIELD_SALT=inrepo-enclave-salt
ENCLAVE_LOG_SHIELD_RING_CAPACITY=1024

## Runtime toggles / debugging
DEBUG_INTEGRITY=false
DEBUG_MPESA=false
DEBUG_REVENUE_SHIELD=false

## Repository / revenue shielding
AUTHORIZED_HOSTS=localhost,127.0.0.1
AUTHORIZED_OWNER=jjaokoth
UNAUTHORIZED_DOMAIN_PATTERNS=vercel.app,netlify.app,github.io,glitch.me
GIT_ORIGIN=https://github.com/jjaokoth/univer-escrow-core.git
REPO_ORIGIN=https://github.com/jjaokoth/univer-escrow-core.git
REPOSITORY_OWNER=jjaokoth
GIT_REMOTE_ORIGIN=https://github.com/jjaokoth/univer-escrow-core.git

## Misc
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret

# NOTE: This file is a template for local development and MUST NOT contain
# production credentials. Copy to `.env` and fill with secure values for
# runtime use. Do NOT commit production secrets.

