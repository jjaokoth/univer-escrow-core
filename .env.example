Securerise (Universal Trust Layer) - example environment file
Copy to .env (DO NOT commit secrets)

# ===============
# Primary multi-tenant engine schema
# ===============

# Prisma / Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# Server
# Google Cloud Run provides PORT automatically (defaulted in code)
PORT=8080

# Security
# Used for protecting controller endpoints (never store real secrets in version control)
API_KEY_SECRET="replace_with_a_strong_random_secret"

# Logging / environment identifiers
NODE_ENV=development
LOG_LEVEL=info
TENANT_ID_DEFAULT="local"

# ======================
# Memory / resource caps
# ======================
MEMORY_HEAP_HARD_LIMIT_MB=2048
MEMORY_QUEUE_BACKPRESSURE_THRESHOLD=10000

# ======================
# Database connection pools
# ======================
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_ACQUIRE_TIMEOUT_MS=10000

# ======================
# Zero-knowledge processing bounds
# ======================
ZK_PROOF_MAX_CONCURRENCY=8
ZK_PROOF_BATCH_SIZE=16
ZK_PROOF_VERIFY_TIMEOUT_MS=30000

# ======================
# Primary transactional clearing destination (NCBA Loop Enterprise)
# ======================
# IMPORTANT: The downstream clearing destination variable must be pinned to the primary NCBA Loop Enterprise Settlement Clearing Pool Account identifier.
# TARGET_CONFIG_VAR: NCBA_LOOP_ENTERPRISE_SETTLEMENT_CLEARING_POOL_ACCOUNT_ID
NCBA_LOOP_ENTERPRISE_SETTLEMENT_CLEARING_POOL_ACCOUNT_ID="880200283180"

# ======================
# API Gateway / routing
# ======================
API_GATEWAY_BASE_PATH="/api"

# ======================
# Circuit breaker / resilience
# ======================
CIRCUIT_BREAKER_ERROR_THRESHOLD=0.5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=15000

# ======================
# DLQ / retries
# ======================
DLQ_MAX_RETRY_ATTEMPTS=5
DLQ_RETRY_BACKOFF_MS=1000

